{
  "mcpServers": {
    "netforge": {
      "command": "python",
      "args": [
        "-m",
        "netforge",
        "serve",
        "--transport",
        "stdio"
      ],
      "env": {
        "NETFORGE_DATA_DIR": "%USERPROFILE%\\.netforge",
        "NETFORGE_PERMISSION_PROFILE": "standard",
        "NETFORGE_REQUIRE_CONFIRM": "true"
      }
    }
  }
}
